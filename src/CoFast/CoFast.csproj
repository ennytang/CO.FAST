<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>CoFast</RootNamespace>
    <AssemblyName>CoFast</AssemblyName>
    <Product>CO.FAST</Product>
    <Description>PrtScn ekran alıntısını seçili AI uygulamasının chatine yapıştırır.</Description>
    <Version>0.1.0</Version>
    <Authors>Enis Özdemir</Authors>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoFast.Tests" />
  </ItemGroup>

</Project>
